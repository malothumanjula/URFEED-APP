# Copy to backend/.env and fill in real values. Never commit backend/.env.

# MySQL (database must already exist: see README)
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/urfeed?charset=utf8mb4

# JWT signing secret (JWT_SECRET_KEY is also accepted)
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=["http://localhost:8080","http://10.0.2.2:8080"]

# AI tagging: "mock" works with no key; "openai" needs OPENAI_API_KEY (AI_API_KEY is also accepted)
AI_PROVIDER=mock
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
SEMANTIC_SEARCH_ENABLED=true

# Optional: separate MySQL database for integration tests (name must end in _test; tables are dropped after each test)
# URFEED_TEST_DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/urfeed_test?charset=utf8mb4
